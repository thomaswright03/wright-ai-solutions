{
  "name": "wright-ai-solutions-site",
  "private": true,
  "description": "Dev tooling only: the site itself is plain static files with no build step or runtime dependencies.",
  "type": "module",
  "scripts": {
    "serve": "node --disable-warning=ExperimentalWarning tests/serve.mjs",
    "test": "playwright test",
    "validate": "html-validate *.html [a-z][a-z]/*.html",
    "i18n": "node scripts/i18n.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p . && tsc -p tsconfig.browser.json",
    "deadcode": "knip --no-progress",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "html-validate": "11.16.1",
    "knip": "6.39.0",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  }
}
